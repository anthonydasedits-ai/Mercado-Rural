<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>Mercadinho Rural</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:#1d2b1f;overflow:hidden;font-family:system-ui,sans-serif;color:#fff;touch-action:none;user-select:none;-webkit-user-select:none}
#app{display:flex;flex-direction:column;height:100%;padding:env(safe-area-inset-top,0) env(safe-area-inset-right,0) env(safe-area-inset-bottom,0) env(safe-area-inset-left,0)}
#top{height:30px;display:flex;align-items:center;gap:10px;padding:0 8px;background:#3b2a1a;border-bottom:2px solid #6b4a2b;font-weight:700;font-size:14px;flex:none}
#top .sp{flex:1}
#top button{background:#f4c542;border:0;border-radius:6px;font-weight:800;padding:3px 10px;font-size:13px}
#wrap{flex:1;position:relative;min-height:0}
#cv{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;image-rendering:pixelated;background:#5fae48}
#joy{position:absolute;left:14px;bottom:10px;width:112px;height:112px;border-radius:50%;background:rgba(0,0,0,.28);border:3px solid rgba(255,255,255,.45)}
#knob{position:absolute;left:34px;top:34px;width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.6)}
#act{position:absolute;right:18px;bottom:16px;width:78px;height:78px;border-radius:50%;border:4px solid #fff8;background:#f4c542;color:#3b2a1a;font-size:30px;font-weight:900}
#act:active{transform:scale(.93)}
#hint{position:absolute;right:10px;bottom:100px;background:rgba(0,0,0,.6);padding:4px 10px;border-radius:10px;font-size:13px;font-weight:700;max-width:46%;text-align:center}
#toast{position:absolute;left:50%;top:8px;transform:translateX(-50%);background:rgba(0,0,0,.7);padding:5px 12px;border-radius:12px;font-size:13px;opacity:0;transition:opacity .25s;pointer-events:none;white-space:nowrap}
#inv{height:46px;flex:none;display:flex;gap:4px;padding:3px 6px;overflow-x:auto;background:#3b2a1a;border-top:2px solid #6b4a2b;touch-action:pan-x}
.slot{flex:none;width:44px;height:38px;border-radius:6px;background:#5a4128;border:2px solid #7d5c38;position:relative;text-align:center;font-size:19px;line-height:32px}
.slot.on{border-color:#f4c542;background:#7d5c38}
.slot i{position:absolute;right:2px;bottom:-1px;font-style:normal;font-size:11px;font-weight:800;line-height:12px;text-shadow:0 1px 2px #000}
.slot.sd::before{content:"🌱";position:absolute;left:1px;top:-2px;font-size:9px;line-height:12px}
#modal{display:none;position:absolute;inset:0;background:rgba(0,0,0,.7);padding:6px;z-index:9;flex-direction:column;align-items:center;padding-top:calc(6px + env(safe-area-inset-top,0))}
#mbox{width:min(560px,100%);flex:1;min-height:0;background:#3b2a1a;border:3px solid #f4c542;border-radius:10px;display:flex;flex-direction:column}
.tabs{display:flex;gap:4px;padding:6px;flex:none;flex-wrap:wrap}
.tb{background:#5a4128;color:#fff;border:0;border-radius:6px;padding:6px 8px;font-size:12px;font-weight:700}
.tb.on{background:#f4c542;color:#3b2a1a}
.body{overflow-y:auto;padding:4px 8px 8px;flex:1;touch-action:pan-y}
.row{display:flex;justify-content:space-between;align-items:center;gap:8px;background:#5a4128;border-radius:8px;padding:6px 8px;margin-bottom:5px;font-size:14px}
